# 0G MAINNET — chain 16661 — all live
# Deployer / owner: 0xf910fC2fD395128A894e9754bE56479F05b54121
#
# This file records the first on-chain Intel TDX attestation stack on 0G.
# Before these deployments, 0G could not verify an Intel DCAP quote at all:
# no RIP-7212 precompile, no P256 verifier, no PCCS, no DCAP entrypoint.

# ── secp256r1 ───────────────────────────────────────────────────────────────
# Intel signs DCAP quotes with P-256, which the EVM cannot verify natively.
# Deployed through the canonical CREATE2 factory, so it sits at the same address
# it holds on every other chain and anyone on 0G can use it.
P256_VERIFIER=0xc2b78104907F722DABAc4C69f826a522B2754De4
P256_TX=0xcbd240c2512a74821b8dd31caffe8ee3e8aad80228b745c83ef4c928e634ce9c

# ── PCCS helpers ────────────────────────────────────────────────────────────
ENCLAVE_IDENTITY_HELPER=0xff41217543a8794384340655A55338985A47A8bd
FMSPC_TCB_HELPER=0x4CD86134f0Ec64263DF710F0414D21a18D116525
PCK_HELPER=0xf42aBCe60e264bA2657463d20E34AD3e2e366d29
X509_CRL_HELPER=0x486F23101cFaAFDD69756a296FC8Ec0929262363
TCB_EVAL_HELPER=0xC8A07d1875dA0C423FD4b53ACA14A79080fA5558

# ── PCCS: the on-chain store for Intel's collateral ─────────────────────────
PCCS_STORAGE=0x07D7233B9CCADBF844fce35F7C1F90B9738F38FE
PCCS_DEPENDENCY_CONFIG=0xCBE1a210247334a46A928d15E6DBED99aE5107e3
PCS_DAO=0x23E49EcfA6C5087d6D9A53894dabd65167e6D9C6
PCK_DAO=0x459dBAfFfd1c8E8d1f358Efaf1812daB50919612
ENCLAVE_IDENTITY_DAO=0x2A357DE7C9E529fE053209ce5905D506e65DA6f4
FMSPC_TCB_DAO=0x0a891AC6c35fA75214D3F902a47f0C1FA378b278
TCB_EVAL_DAO=0xd16a8697416d49A814a65A24e1D94e8b59523d8c

# ── DCAP verification core ──────────────────────────────────────────────────
# verifyAndAttestOnChain(bytes) lives on DCAP_VERIFIER. Confirmed working: a
# malformed quote returns (false, "Quote length is less than Header length"),
# i.e. the entrypoint routes to the V4 TDX parser and the parser runs.
DCAP_ROUTER=0xb66b1d67d156Fb7FC21B6cb9Be573C118C37e4f4
DCAP_VERIFIER=0x51Be618E3CA0b0B19FA0cC6c10960fF62783Da86
V4_VERIFIER=0xabbd2E13d5eda2D75D1599A7539a3083dfaba715

# ── Cambrian ────────────────────────────────────────────────────────────────
# Biosphere: deploy with
#   forge create contracts/src/Biosphere.sol:Biosphere \
#     --rpc-url https://evmrpc.0g.ai --private-key "$PRIVATE_KEY" --broadcast \
#     --constructor-args 0x51Be618E3CA0b0B19FA0cC6c10960fF62783Da86
BIOSPHERE=0xec998587D4429D10C02915df237015cc1f92cf5E
BIOSPHERE_TX=0xed2160818f633e893e84a3d5abdfed2303f54a199b89cd4e56932597955df105
# Redeployed 2026-09-02 with the post-audit contract: pins the quote verifier,
# enforces MIN_ENDOWMENT, inherits soma to children, and has no commons drain.
# The pre-audit Biosphere at 0x577B2121…849dE is abandoned and was never populated.

# Genesis organism: needs a real measurement from a TDX CVM. Do NOT guess this —
# a wrong identity yields an organism that is funded, alive, and permanently mute.
GENESIS_IDENTITY=
ORGANISM=
